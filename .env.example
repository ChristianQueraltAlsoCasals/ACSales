# Copia este archivo a .env y rellena los valores.
# Un solo .env en la raíz (como ACTDrive / achuman). NO subir .env a git.

# =============================================================================
# Infra (Docker / Postgres)
# =============================================================================
APP_PORT=8102
DB_PASSWORD=acsales
DB_PORT=5434
# Desarrollo local (Node en el host → Postgres publicado en DB_PORT):
DATABASE_URL=postgres://acsales:acsales@localhost:5434/acsales
# En Docker Compose, DATABASE_URL se sobrescribe a @db:5432 automáticamente.

# Puerto del API en desarrollo local (npm start). En el contenedor es 8102.
PORT=3000

# Registro «solo Recibir» (orden en server.cjs):
#   1) API alsocasals/purchasing/v1.0 → Microsoft.NAV.receive / receiveByNumber (body orderNo)
#   2) API v2 Microsoft.NAV.receive (Also Production NO la expone hoy)
#   3) Respaldo Playwright en el host (opcional):
BC_REGISTRO_URL=http://host.docker.internal:5055
# En local sin Docker app: http://localhost:5055
# v2 SÍ tiene receiveAndInvoice (recibir+facturar). NO activar en recepción parcial:
# BC_ALLOW_RECEIVE_AND_INVOICE=false
# BC_REGISTRO_ACCION=receive

# =============================================================================
# Anthropic (Claude)
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================================
# Business Central (misma app Azure que otras apps AC / Finance Hub [bc])
# =============================================================================
BC_TENANT_ID=2070af18-f15b-4bea-9971-530cdd74f64e
BC_ENVIRONMENT=Production
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_COMPANY_ID=
BC_COMPANY_NAME=Also Casals
BC_CAMPO_OT=noOT
BC_CAMPO_SEGMENTO=shortcut_Dimension_1_Code
BC_PAGE_PEDIDO_COMPRA=9307
BC_WS_JOBLIST=Job_List
BC_WS_LINEASVENTA=Sales_Order_Line_Excel
BC_WS_LINEASCOMPRA=Líns_compra_Excel
BC_WS_LINEASVENTA_REG=Maria
BC_WS_LINEASCOMPRA_REG=
BC_WS_PEDIDOSCOMPRA=Pedido_compra_Excel
BC_WS_LINEASPEDIDOVENTA=
BC_WS_MOVSPROYECTO=Movs_proyecto_Excel
BC_WS_JOBLEDGER=JobLedgerEntries
BC_WS_TARIFASVENTA=Price_List_Lines_Excel
# Movimientos de contabilidad con Cód. Línea de negocio (tasas estructura / venda objectiu)
BC_WS_MOVSCONTAB=Movs_contabilidad_Excel
# Cómo obtener OT / LN en movs contabilidad y tasas:
#   api_expand = API v2.0 + dimensionSetLines (recomendado; LN real)
#   ws         = web service primero (comportamiento anterior; revertir aquí)
BC_MOVS_DIM_MODE=api_expand
# Multiempresa / IA BC (regex sobre nombre de empresa)
APP_EMPRESAS=also|ferros|quimlab
IA_BC_EMPRESAS=also|ferros|quimlab

# =============================================================================
# Microsoft 365 Graph (correo recepción / facturas / buzón personal)
# =============================================================================
M365_TENANT_ID=2070af18-f15b-4bea-9971-530cdd74f64e
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_BUZON_ALBARANES=albarans@alsocasals.com
M365_BUZON_FACTURAS=facturacio@alsocasals.com
M365_BUZON_PERSONAL=
M365_DIAS=1
M365_MARCAR_LEIDO=true

# =============================================================================
# Ecosistema AC — login ERP (ACapp) + ACconstelation
# Mismo patrón que achuman / aclogistics / ACTDrive.
# =============================================================================
JWT_SECRET=
ADMIN_USER=admin
ADMIN_EMAIL=admin@empresa.local
ADMIN_PASSWORD=canviam123
COOKIE_SEGURA=false
CONSTELLATION_URL=https://acconstelation.alsocasals.com
# CONSTELLATION_PUBLIC_URL=https://acconstelation.alsocasals.com
SSO_SERVICE_SECRET=
SSO_REDIRECT=/
ERP_MSSQL_HOST=
ERP_MSSQL_PORT=1433
ERP_MSSQL_DATABASE=ALSOAPP
ERP_MSSQL_USER=
ERP_MSSQL_PASSWORD=
ERP_MSSQL_ENCRYPT=true
ERP_MSSQL_TRUST_SERVER_CERT=true
# Timeouts cortos: si el SQL físico no responde, login vía portal (cache)
ERP_MSSQL_CONNECT_TIMEOUT_MS=2500
ERP_MSSQL_REQUEST_TIMEOUT_MS=3000
ERP_EMPRESA_DEFECTE=0001
PUBLIC_URL=http://localhost:8102

# AChuman — email_empresa del colaborador (remitente de correos)
ACHUMAN_URL=https://achuman.alsocasals.com
# Por defecto reutiliza SSO_SERVICE_SECRET; opcional override:
# ACHUMAN_SERVICE_SECRET=

# ACFactory — alta de productos desde la IA (Also + Ferros + App)
# Docker local: http://host.docker.internal:8103
# Node en host: http://localhost:8103
# Prod: https://acfactory.alsocasals.com
ACFACTORY_URL=http://host.docker.internal:8103
# Si vacío, usa SSO_SERVICE_SECRET (mismo valor que en ACFactory)
# ACFACTORY_SERVICE_SECRET=

# Mapeo Also→Ferros (histórico artículos). Por defecto: data/mapeo_reemplazo_items.csv
# MAPEO_ARTICULOS_CSV=
