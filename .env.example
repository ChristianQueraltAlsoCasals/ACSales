# Copia este archivo a .env y rellena los valores.
# Un solo .env en la raíz (como ACTDrive / achuman). NO subir .env a git.

# =============================================================================
# Infra (Docker / Postgres)
# =============================================================================
APP_PORT=8102
DB_PASSWORD=acsales
DB_PORT=5434
# Desarrollo local (Node en el host → Postgres publicado en DB_PORT):
DATABASE_URL=postgres://acsales:acsales@localhost:5434/acsales
# En Docker Compose, DATABASE_URL se sobrescribe a @db:5432 automáticamente.

# Puerto del API en desarrollo local (npm start). En el contenedor es 8102.
PORT=3000

# Playwright en el host (recepción "Registrar"). Desde Docker:
BC_REGISTRO_URL=http://host.docker.internal:5055
# En local sin Docker app: http://localhost:5055

# =============================================================================
# Anthropic (Claude)
# =============================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# =============================================================================
# Business Central (misma app Azure que otras apps AC / Finance Hub [bc])
# =============================================================================
BC_TENANT_ID=2070af18-f15b-4bea-9971-530cdd74f64e
BC_ENVIRONMENT=Production
BC_CLIENT_ID=
BC_CLIENT_SECRET=
BC_COMPANY_ID=
BC_COMPANY_NAME=Also Casals
BC_CAMPO_OT=noOT
BC_CAMPO_SEGMENTO=shortcut_Dimension_1_Code
BC_PAGE_PEDIDO_COMPRA=9307
BC_WS_JOBLIST=Job_List
BC_WS_LINEASVENTA=Sales_Order_Line_Excel
BC_WS_LINEASCOMPRA=Líns_compra_Excel
BC_WS_LINEASVENTA_REG=
BC_WS_LINEASCOMPRA_REG=
BC_WS_PEDIDOSCOMPRA=Pedido_compra_Excel
BC_WS_LINEASPEDIDOVENTA=

# =============================================================================
# Microsoft 365 Graph (correo recepción / facturas / buzón personal)
# =============================================================================
M365_TENANT_ID=2070af18-f15b-4bea-9971-530cdd74f64e
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_BUZON_ALBARANES=albarans@alsocasals.com
M365_BUZON_FACTURAS=facturacio@alsocasals.com
M365_BUZON_PERSONAL=
M365_DIAS=1
M365_MARCAR_LEIDO=true

# =============================================================================
# Ecosistema AC — login ERP (ACapp) + ACconstelation
# Mismo patrón que achuman / aclogistics / ACTDrive.
# =============================================================================
JWT_SECRET=
ADMIN_USER=admin
ADMIN_EMAIL=admin@empresa.local
ADMIN_PASSWORD=canviam123
COOKIE_SEGURA=false
CONSTELLATION_URL=https://acconstelation.alsocasals.com
# CONSTELLATION_PUBLIC_URL=https://acconstelation.alsocasals.com
SSO_SERVICE_SECRET=
SSO_REDIRECT=/
ERP_MSSQL_HOST=
ERP_MSSQL_PORT=1433
ERP_MSSQL_DATABASE=ALSOAPP
ERP_MSSQL_USER=
ERP_MSSQL_PASSWORD=
ERP_MSSQL_ENCRYPT=true
ERP_MSSQL_TRUST_SERVER_CERT=true
ERP_EMPRESA_DEFECTE=0001
PUBLIC_URL=http://localhost:8102

# AChuman — email_empresa del colaborador (remitente de correos)
ACHUMAN_URL=https://achuman.alsocasals.com
# Por defecto reutiliza SSO_SERVICE_SECRET; opcional override:
# ACHUMAN_SERVICE_SECRET=
